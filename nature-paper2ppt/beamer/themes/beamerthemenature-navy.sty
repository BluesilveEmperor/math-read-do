\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemenature-navy}[2026/10/01 v2.0 Navy: deep blue with a warm accent]

% --- Palette -----------------------------------------------------------------
% One cool dominant, one warm accent used sparingly for emphasis only.
\definecolor{ntNavyText}{HTML}{152238}
\definecolor{ntNavyMuted}{HTML}{6B7A90}
\definecolor{ntNavyAccent}{HTML}{2E4A6B}
\definecolor{ntNavyWarm}{HTML}{B5651D}
\definecolor{ntNavyRule}{HTML}{C9D2DE}
\definecolor{ntNavyPanel}{HTML}{EDF1F6}

\newcommand{\ntPaletteText}{ntNavyText}
\newcommand{\ntPaletteMuted}{ntNavyMuted}
\newcommand{\ntPaletteAccent}{ntNavyAccent}
\newcommand{\ntPaletteWarm}{ntNavyWarm}
\newcommand{\ntPaletteRule}{ntNavyRule}
\newcommand{\ntPalettePanel}{ntNavyPanel}

% Figure-page vertical budget for this theme (fractions of \textheight).
\providecommand{\ntFigGraphicFrac}{0.50}
\providecommand{\ntFigCaptionFrac}{0.135}
% --- Typography --------------------------------------------------------------
\newcommand{\ntFontTitleCn}{HarmonyOS Sans SC}
\newcommand{\ntFontBodyCn}{HarmonyOS Sans SC}
\newcommand{\ntFontTitleEn}{Source Sans Pro}
\newcommand{\ntFontBodyEn}{Source Sans Pro}
\providecommand{\ntFontTitleCnFace}{HarmonyOS Sans SC Regular}
\providecommand{\ntFontTitleCnBoldFace}{HarmonyOS Sans SC Medium}
\providecommand{\ntFontBodyCnFace}{HarmonyOS Sans SC Regular}
\providecommand{\ntFontBodyCnBoldFace}{HarmonyOS Sans SC Medium}

\RequirePackage{../common/beamer-nature-common}
\RequirePackage{tikz}

% Warm accent also drives beamer's own alert colour.
\setbeamercolor{alerted text}{fg=\ntPaletteWarm}

% --- Chrome: a rule under the title, a progress bar along the bottom ---------
\newcommand{\ntFooter}{%
  \begin{tikzpicture}[remember picture,overlay]
    % Progress bar sits on the very bottom edge; its labels sit above it.
    \fill[\ntPaletteRule]
      ([yshift=1.7mm]current page.south west) rectangle
      ([yshift=2.5mm]current page.south east);
    \fill[\ntPaletteAccent]
      ([yshift=1.7mm]current page.south west) rectangle
      ([xshift=\dimexpr\paperwidth*\insertframenumber/\ntframecount\relax,
        yshift=2.5mm]current page.south west);
    \node[anchor=south west,inner sep=0pt]
      at ([xshift=10mm,yshift=3.8mm]current page.south west)
      {\fontsize{6.8}{7.8}\selectfont\color{\ntPaletteMuted}\insertshorttitle};
    \node[anchor=south east,inner sep=0pt]
      at ([xshift=-10mm,yshift=3.8mm]current page.south east)
      {\fontsize{6.8}{7.8}\selectfont\color{\ntPaletteMuted}%
       \insertframenumber\,/\,\ntframecount};
  \end{tikzpicture}%
}

% Title block: title + two-tone rule (short accent segment leading a light
% full-width hairline), ~11mm total so body content starts high.
\setbeamertemplate{frametitle}{%
  \vspace{2.1mm}%
  {\fontsize{15}{18}\selectfont\color{\ntPaletteText}\bfseries
   \insertframetitle\par}%
  \vspace{1.3mm}%
  {\color{\ntPaletteAccent}\rule{12mm}{0.8pt}\hspace{0.5mm}%
   \color{\ntPaletteRule}\rule{\dimexpr\linewidth-12.5mm\relax}{0.8pt}\par}%
  \vspace{1.5mm}%
}
\setbeamertemplate{footline}{}
\addtobeamertemplate{frametitle}{\ntFooter}{}

% --- Body slides -------------------------------------------------------------
\setbeamertemplate{itemize item}{\color{\ntPaletteAccent}\rule[0.42ex]{1.6mm}{1.6mm}}
\setbeamertemplate{itemize subitem}{\color{\ntPaletteWarm}\textendash}
\setbeamertemplate{enumerate item}{%
  {\fontsize{9.4}{10}\selectfont\color{\ntPaletteWarm}\bfseries\insertenumlabel}%
}
\setbeamerfont{itemize/enumerate body}{size=\fontsize{10}{13.2}}
\setbeamerfont{itemize/enumerate subbody}{size=\fontsize{9}{11.6}}

% Blocks take the warm accent as a left bar rather than a filled box.
\setbeamertemplate{block begin}{%
  \vskip3mm%
  \begin{beamercolorbox}[wd=\linewidth,sep=0pt]{block body}%
    {\color{\ntPaletteWarm}\rule{1.5mm}{0pt}%
     \hspace{-1.5mm}\color{\ntPaletteWarm}\vrule width 1.5mm}%
    \hspace{1.8mm}%
    \begin{minipage}[t]{\dimexpr\linewidth-4.6mm\relax}%
      {\fontsize{9.8}{11.8}\selectfont\color{\ntPaletteWarm}\bfseries
       \insertblocktitle\par}\vspace{0.8mm}%
}
\setbeamertemplate{block end}{%
    \end{minipage}%
  \end{beamercolorbox}%
  \vskip1mm%
}

% --- Title page --------------------------------------------------------------
% The navy band is a full-bleed overlay; all cover text is drawn as overlay
% nodes too, so the vertical rhythm is fixed and cannot drift when the title
% wraps to a second line. Drawing some text in the overlay and some in the
% normal text flow is what previously pushed the author line into the band.
\newcommand{\naturetitlepage}{%
  \begin{frame}[plain]
    \begin{tikzpicture}[remember picture,overlay]
      % Band across the upper ~42% of the page.
      \fill[\ntPaletteAccent]
        (current page.north west) rectangle
        ([yshift=-37mm]current page.north east);
      \fill[\ntPaletteWarm]
        ([yshift=-37mm]current page.north west) rectangle
        ([yshift=-38.2mm]current page.north east);

      % Kicker sits at the top of the band, well clear of the title below it.
      \node[anchor=north west,inner sep=0pt,
            text width=\dimexpr\paperwidth-20mm\relax]
        at ([xshift=10mm,yshift=-10mm]current page.north west)
        {\fontsize{7.6}{9}\selectfont\color{white!70!ntNavyAccent}%
         \MakeUppercase{文献汇报}};

      % Title anchored to the bottom of the band so a two-line title grows
      % upward instead of colliding with the kicker.
      \node[anchor=south west,inner sep=0pt,
            text width=\dimexpr\paperwidth-20mm\relax]
        at ([xshift=10mm,yshift=-33mm]current page.north west)
        {\setlength{\baselineskip}{13pt}%
         \fontsize{18}{21.5}\selectfont\color{white}\bfseries\inserttitle};

      % Attribution block on the light field below the band.
      \node[anchor=north west,inner sep=0pt,
            text width=\dimexpr\paperwidth-20mm\relax]
        at ([xshift=10mm,yshift=-47mm]current page.north west)
        {\fontsize{10}{12.4}\selectfont\color{ntNavyText}\insertauthor\par
         \vspace{1.6mm}%
         \fontsize{8.4}{10.4}\selectfont\color{ntNavyMuted}\insertinstitute};

      \node[anchor=south west,inner sep=0pt]
        at ([xshift=10mm,yshift=7.5mm]current page.south west)
        {\fontsize{8}{9.8}\selectfont\color{ntNavyMuted}%
         \ifx\ntVenue\undefined\else\ntVenue\quad·\quad\fi\insertdate};
    \end{tikzpicture}%
  \end{frame}%
}

% --- Section divider ---------------------------------------------------------
% v1 placed the phrase with \hspace{32mm} after an overlay, which never took
% effect and left the section title sitting on top of the rotated PART label
% inside the band. Everything is now drawn as overlay nodes at fixed offsets,
% so the layout cannot drift.
\newcommand{\naturesection}[1]{%
  \begin{frame}[plain]
    \begin{tikzpicture}[remember picture,overlay]
      % Left band with a warm seam at its right edge.
      \fill[\ntPaletteAccent]
        (current page.north west) rectangle
        ([xshift=32mm]current page.south west);
      \fill[\ntPaletteWarm]
        ([xshift=32mm]current page.north west) rectangle
        ([xshift=33.2mm]current page.south west);

      % Kicker + section phrase on the light field, vertically centred.
      \node[anchor=west,inner sep=0pt,
            text width=\dimexpr\paperwidth-52mm\relax]
        at ([xshift=40mm]current page.west)
        {{\fontsize{8}{9.6}\selectfont\color{\ntPaletteMuted}%
          \MakeUppercase{Part}\par}%
         \vspace{2.6mm}%
         {\fontsize{18}{22}\selectfont\color{\ntPaletteText}\bfseries #1\par}%
         \vspace{3.2mm}%
         {\color{\ntPaletteWarm}\rule{18mm}{1pt}\par}};
    \end{tikzpicture}%
  \end{frame}%
}

% --- Two-column comparison ---------------------------------------------------
\newcommand{\naturetwocol}[5]{%
  \begin{frame}[t]{#1}
    \begin{columns}[T,onlytextwidth]
      \begin{column}{0.48\textwidth}
        {\fontsize{9.6}{11.2}\selectfont\color{\ntPaletteAccent}\bfseries #2\par}
        \vspace{1.3mm}
        {\color{\ntPaletteAccent}\rule{9mm}{0.8pt}\par}
        \vspace{1.8mm}
        {\fontsize{9.6}{12.4}\selectfont #3\par}
      \end{column}
      \hfill
      \begin{column}{0.48\textwidth}
        {\fontsize{9.6}{11.2}\selectfont\color{\ntPaletteWarm}\bfseries #4\par}
        \vspace{1.3mm}
        {\color{\ntPaletteWarm}\rule{9mm}{0.8pt}\par}
        \vspace{1.8mm}
        {\fontsize{9.6}{12.4}\selectfont #5\par}
      \end{column}
    \end{columns}
  \end{frame}%
}

% --- Closing -----------------------------------------------------------------
\newcommand{\natureclosing}[1]{%
  \begin{frame}[plain]
    \begin{tikzpicture}[remember picture,overlay]
      \fill[\ntPaletteAccent]
        ([yshift=0mm]current page.south west) rectangle
        ([yshift=17mm]current page.south east);
      \fill[\ntPaletteWarm]
        ([yshift=17mm]current page.south west) rectangle
        ([yshift=18.2mm]current page.south east);
    \end{tikzpicture}
    \vfill
    \centering
    {\fontsize{17}{20.5}\selectfont\color{\ntPaletteText}\bfseries #1\par}
    \vspace{3.2mm}
    {\color{\ntPaletteWarm}\rule{18mm}{1pt}\par}
    \vspace{22mm}
  \end{frame}%
}
