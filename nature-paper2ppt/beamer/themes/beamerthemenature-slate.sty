\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemenature-slate}[2026/10/01 v2.0 Slate: grey-blue monochrome]

% --- Palette -----------------------------------------------------------------
\definecolor{ntSlateText}{HTML}{1F2933}
\definecolor{ntSlateMuted}{HTML}{8A93A0}
\definecolor{ntSlateAccent}{HTML}{6B7C8C}
\definecolor{ntSlateRule}{HTML}{D8DEE6}
\definecolor{ntSlatePanel}{HTML}{F3F5F7}

\newcommand{\ntPaletteText}{ntSlateText}
\newcommand{\ntPaletteMuted}{ntSlateMuted}
\newcommand{\ntPaletteAccent}{ntSlateAccent}
\newcommand{\ntPaletteRule}{ntSlateRule}
\newcommand{\ntPalettePanel}{ntSlatePanel}

% Figure-page vertical budget for this theme (fractions of \textheight).
\providecommand{\ntFigGraphicFrac}{0.52}
\providecommand{\ntFigCaptionFrac}{0.14}
% --- Typography --------------------------------------------------------------
% HarmonyOS Sans SC ships three files: Regular / Medium / Bold. Faces are named
% explicitly because the bold face is a separate file, not a style of the same
% family string (see the CJK setup in the common layer).
\newcommand{\ntFontTitleCn}{HarmonyOS Sans SC}
\newcommand{\ntFontBodyCn}{HarmonyOS Sans SC}
\newcommand{\ntFontTitleEn}{Source Sans Pro}
\newcommand{\ntFontBodyEn}{Source Sans Pro}
\providecommand{\ntFontTitleCnFace}{HarmonyOS Sans SC Regular}
\providecommand{\ntFontTitleCnBoldFace}{HarmonyOS Sans SC Medium}
\providecommand{\ntFontBodyCnFace}{HarmonyOS Sans SC Regular}
\providecommand{\ntFontBodyCnBoldFace}{HarmonyOS Sans SC Medium}

\RequirePackage{../common/beamer-nature-common}
\RequirePackage{tikz}

% --- Chrome: a 1.2mm accent bar across the very top, nothing else ------------
\newcommand{\ntTopbar}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[\ntPaletteAccent]
      (current page.north west) rectangle ([yshift=-1.2mm]current page.north east);
  \end{tikzpicture}%
}

% The title block is deliberately shallow: title + hairline, ~11mm total, so
% body content starts high on the page.
\setbeamertemplate{frametitle}{%
  \vspace{2.2mm}%
  {\fontsize{15.5}{18.5}\selectfont\color{\ntPaletteText}\bfseries\insertframetitle\par}%
  \vspace{1.4mm}%
  {\color{\ntPaletteRule}\rule{\linewidth}{0.5pt}\par}%
  \vspace{1.6mm}%
}

% The footer is drawn as an overlay pinned to the page bottom. Beamer's normal
% footline template participates in the text block and therefore overlapped the
% \nttakeaway panel on figure slides; an overlay cannot collide with content.
\setbeamertemplate{footline}{}
\newcommand{\ntFooter}{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=south west,inner sep=0pt]
      at ([xshift=10mm,yshift=2.8mm]current page.south west)
      {\fontsize{6.8}{7.8}\selectfont\color{\ntPaletteMuted}\insertshorttitle};
    \node[anchor=south east,inner sep=0pt]
      at ([xshift=-10mm,yshift=2.8mm]current page.south east)
      {\fontsize{6.8}{7.8}\selectfont\color{\ntPaletteMuted}%
       \insertframenumber\,/\,\ntframecount};
  \end{tikzpicture}%
}
\addtobeamertemplate{frametitle}{\ntFooter}{}

% --- Body slides -------------------------------------------------------------
\setbeamertemplate{itemize item}{\color{\ntPaletteRule}\rule[0.42ex]{1.6mm}{1.6mm}}
\setbeamertemplate{itemize subitem}{\color{\ntPaletteMuted}\textendash}
\setbeamertemplate{enumerate item}{%
  {\fontsize{9.4}{10}\selectfont\color{\ntPaletteAccent}\bfseries\insertenumlabel}%
}

\setbeamerfont{itemize/enumerate body}{size=\fontsize{10}{13.2}}
\setbeamerfont{itemize/enumerate subbody}{size=\fontsize{9}{11.6}}

% --- Title page --------------------------------------------------------------
\newcommand{\naturetitlepage}{%
  \begin{frame}[plain]
    \ntTopbar
    \vspace{12mm}
    {\ntkicker{文献汇报}\par}
    \vspace{3mm}
    {\fontsize{21}{25}\selectfont\color{\ntPaletteText}\bfseries
     \inserttitle\par}
    \vspace{4.2mm}
    {\color{\ntPaletteRule}\rule{32mm}{0.7pt}\par}
    \vspace{3.8mm}
    {\fontsize{10}{12.4}\selectfont\color{\ntPaletteMuted}%
     \insertauthor\par}
    \vspace{1.6mm}
    {\fontsize{8.4}{10.4}\selectfont\color{\ntPaletteMuted}%
     \insertinstitute\par}
    \vfill
    {\fontsize{8}{9.8}\selectfont\color{\ntPaletteMuted}%
     \ifx\ntVenue\undefined\else\ntVenue\quad·\quad\fi\insertdate\par}
    \vspace{4mm}
  \end{frame}%
}

% --- Section divider ---------------------------------------------------------
\newcommand{\naturesection}[1]{%
  \begin{frame}[plain]
    \ntTopbar
    \vfill
    {\ntkicker{Part}\par}
    \vspace{2.6mm}
    {\fontsize{18}{22}\selectfont\color{\ntPaletteText}\bfseries #1\par}
    \vspace{3mm}
    {\color{\ntPaletteRule}\rule{20mm}{0.7pt}\par}
    \vfill
  \end{frame}%
}

% --- Two-column comparison ---------------------------------------------------
% \naturetwocol{title}{left head}{left body}{right head}{right body}
\newcommand{\naturetwocol}[5]{%
  \begin{frame}[t]{#1}
    \begin{columns}[T,onlytextwidth]
      \begin{column}{0.48\textwidth}
        {\fontsize{9.6}{11.2}\selectfont\color{\ntPaletteAccent}\bfseries #2\par}
        \vspace{1.4mm}
        {\color{\ntPaletteRule}\rule{\linewidth}{0.5pt}\par}
        \vspace{1.8mm}
        {\fontsize{9.6}{12.4}\selectfont #3\par}
      \end{column}
      \hfill
      \begin{column}{0.48\textwidth}
        {\fontsize{9.6}{11.2}\selectfont\color{\ntPaletteAccent}\bfseries #4\par}
        \vspace{1.4mm}
        {\color{\ntPaletteRule}\rule{\linewidth}{0.5pt}\par}
        \vspace{1.8mm}
        {\fontsize{9.6}{12.4}\selectfont #5\par}
      \end{column}
    \end{columns}
  \end{frame}%
}

% --- Closing -----------------------------------------------------------------
\newcommand{\natureclosing}[1]{%
  \begin{frame}[plain]
    \ntTopbar
    \vfill
    \centering
    {\fontsize{17}{20.5}\selectfont\color{\ntPaletteText}\bfseries #1\par}
    \vspace{3.6mm}
    {\color{\ntPaletteRule}\rule{20mm}{0.7pt}\par}
    \vfill
  \end{frame}%
}
