\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemenature-paper}[2026/10/01 v2.0 Paper: warm white, serif headings, print-first]

% --- Palette -----------------------------------------------------------------
% A warm off-white field rather than pure white, so projected and printed
% output both read softer. Ink is a warm near-black, not neutral grey.
\definecolor{ntPaperField}{HTML}{FBF9F5}
\definecolor{ntPaperText}{HTML}{23201C}
\definecolor{ntPaperMuted}{HTML}{8C857C}
\definecolor{ntPaperAccent}{HTML}{8A6D3B}
\definecolor{ntPaperRule}{HTML}{DED8CE}
\definecolor{ntPaperPanel}{HTML}{F0EAE0}

\newcommand{\ntPaletteText}{ntPaperText}
\newcommand{\ntPaletteMuted}{ntPaperMuted}
\newcommand{\ntPaletteAccent}{ntPaperAccent}
\newcommand{\ntPaletteRule}{ntPaperRule}
\newcommand{\ntPalettePanel}{ntPaperPanel}

% Figure-page vertical budget for this theme (fractions of \textheight).
\providecommand{\ntFigGraphicFrac}{0.51}
\providecommand{\ntFigCaptionFrac}{0.14}
% --- Typography --------------------------------------------------------------
% Headings in a serif face, body in sans: the contrast is what gives this theme
% its print-like character. Source Serif Pro comes from TeX Live, so no
% Windows-only serif is required.
\newcommand{\ntFontTitleCn}{HarmonyOS Sans SC}
\newcommand{\ntFontBodyCn}{HarmonyOS Sans SC}
\newcommand{\ntFontTitleEn}{Source Serif Pro}
\newcommand{\ntFontBodyEn}{Source Sans Pro}
\providecommand{\ntFontTitleCnFace}{HarmonyOS Sans SC Regular}
\providecommand{\ntFontTitleCnBoldFace}{HarmonyOS Sans SC Medium}
\providecommand{\ntFontBodyCnFace}{HarmonyOS Sans SC Regular}
\providecommand{\ntFontBodyCnBoldFace}{HarmonyOS Sans SC Medium}

\RequirePackage{../common/beamer-nature-common}
\RequirePackage{tikz}

% Warm field applied to the whole page. The colour name is written bare:
% wrapping a \definecolor name in a macro makes xcolor match the macro token
% rather than the expanded name and fail with "Undefined color ''".
\setbeamercolor{background canvas}{bg=ntPaperField}

% --- Chrome: page number centred, short title left ---------------------------
\newcommand{\ntFooter}{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=south,inner sep=0pt]
      at ([yshift=3.2mm]current page.south)
      {\fontsize{6.8}{7.8}\selectfont\color{\ntPaletteMuted}\insertframenumber};
    \node[anchor=south west,inner sep=0pt]
      at ([xshift=10mm,yshift=3.2mm]current page.south west)
      {\fontsize{6.8}{7.8}\selectfont\color{\ntPaletteMuted}\insertshorttitle};
  \end{tikzpicture}%
}

\setbeamertemplate{frametitle}{%
  \vspace{2.4mm}%
  {\fontsize{16}{19}\selectfont\color{ntPaperText}\bfseries
   \setlength{\baselineskip}{19pt}\insertframetitle\par}%
  \vspace{1.3mm}%
  {\color{\ntPaletteRule}\rule{24mm}{0.6pt}\par}%
  \vspace{1.8mm}%
}
\setbeamertemplate{footline}{}
\addtobeamertemplate{frametitle}{\ntFooter}{}

% --- Body slides -------------------------------------------------------------
\setbeamertemplate{itemize item}{\color{\ntPaletteAccent}\raise0.1ex\hbox{\fontsize{6}{6}\selectfont$\bullet$}}
\setbeamertemplate{itemize subitem}{\color{\ntPaletteMuted}\textendash}
\setbeamertemplate{enumerate item}{%
  {\fontsize{9.2}{9.8}\selectfont\color{\ntPaletteAccent}\bfseries\insertenumlabel.}%
}
\setbeamerfont{itemize/enumerate body}{size=\fontsize{10}{13}}
\setbeamerfont{itemize/enumerate subbody}{size=\fontsize{9}{11.4}}

% Blocks read as a tinted inset on the warm field.
% v1 built the inset from an \hbox + \vrule whose panel colour leaked past its
% group, so the block body inherited the near-white panel colour and became
% invisible. A beamercolorbox owns its background and foreground explicitly,
% so no colour can escape -- and it splits cleanly across the block begin /
% block end templates because it is an environment.
\setbeamercolor{ntblock}{bg=ntPaperPanel,fg=ntPaperText}
\setbeamertemplate{block begin}{%
  \vskip3mm%
  \begin{beamercolorbox}[wd=\linewidth,sep=2.2mm,leftskip=1mm,rightskip=1mm]{ntblock}%
    {\fontsize{9.6}{11.4}\selectfont\color{ntPaperAccent}\bfseries
     \insertblocktitle\par}%
    \vspace{1mm}%
}
\setbeamertemplate{block end}{%
  \end{beamercolorbox}%
  \vskip1mm%
}

% --- Title page --------------------------------------------------------------
\newcommand{\naturetitlepage}{%
  \begin{frame}[plain]
    \vspace{16mm}
    \centering
    {\color{\ntPaletteAccent}\rule{16mm}{0.8pt}\par}
    \vspace{5mm}
    {\fontsize{7.6}{9.4}\selectfont\color{\ntPaletteMuted}\MakeUppercase{文献汇报}\par}
    \vspace{3.6mm}
    {\fontsize{21}{25}\selectfont\color{ntPaperText}\bfseries
     \setlength{\baselineskip}{25pt}\inserttitle\par}
    \vspace{6mm}
    {\color{\ntPaletteRule}\rule{34mm}{0.5pt}\par}
    \vspace{4.6mm}
    {\fontsize{10}{12.4}\selectfont\color{ntPaperText}\insertauthor\par}
    \vspace{1.6mm}
    {\fontsize{8.4}{10.4}\selectfont\color{\ntPaletteMuted}\insertinstitute\par}
    \vfill
    {\fontsize{8}{9.8}\selectfont\color{\ntPaletteMuted}%
     \ifx\ntVenue\undefined\else\ntVenue\quad·\quad\fi\insertdate\par}
    \vspace{5mm}
  \end{frame}%
}

% --- Section divider ---------------------------------------------------------
\newcommand{\naturesection}[1]{%
  \begin{frame}[plain]
    \vfill
    \centering
    {\fontsize{7.8}{9.6}\selectfont\color{\ntPaletteAccent}\MakeUppercase{Part}\par}
    \vspace{3.2mm}
    {\fontsize{18}{21.5}\selectfont\color{ntPaperText}\bfseries #1\par}
    \vspace{4mm}
    {\color{\ntPaletteRule}\rule{20mm}{0.6pt}\par}
    \vfill
  \end{frame}%
}

% --- Two-column comparison ---------------------------------------------------
\newcommand{\naturetwocol}[5]{%
  \begin{frame}[t]{#1}
    \begin{columns}[T,onlytextwidth]
      \begin{column}{0.48\textwidth}
        {\fontsize{9.8}{11.6}\selectfont\color{ntPaperAccent}\bfseries #2\par}
        \vspace{1.3mm}
        {\color{\ntPaletteRule}\rule{\linewidth}{0.5pt}\par}
        \vspace{1.8mm}
        {\fontsize{9.6}{12.4}\selectfont #3\par}
      \end{column}
      \hfill
      \begin{column}{0.48\textwidth}
        {\fontsize{9.8}{11.6}\selectfont\color{\ntPaletteMuted}\bfseries #4\par}
        \vspace{1.3mm}
        {\color{\ntPaletteRule}\rule{\linewidth}{0.5pt}\par}
        \vspace{1.8mm}
        {\fontsize{9.6}{12.4}\selectfont #5\par}
      \end{column}
    \end{columns}
  \end{frame}%
}

% --- Closing -----------------------------------------------------------------
\newcommand{\natureclosing}[1]{%
  \begin{frame}[plain]
    \vfill
    \centering
    {\fontsize{17}{20.5}\selectfont\color{ntPaperText}\bfseries #1\par}
    \vspace{3.6mm}
    {\color{\ntPaletteAccent}\rule{16mm}{0.8pt}\par}
    \vfill
  \end{frame}%
}
