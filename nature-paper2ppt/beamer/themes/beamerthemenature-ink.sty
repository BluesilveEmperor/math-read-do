\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemenature-ink}[2026/10/01 v2.0 Ink: near-black, achromatic, figure-first]

% --- Palette -----------------------------------------------------------------
% Deliberately achromatic. Emphasis is expressed through weight and scale, not
% colour, so the only value that carries meaning is the near-black text.
\definecolor{ntInkBlack}{HTML}{111114}
\definecolor{ntInkText}{HTML}{1C1C1E}
\definecolor{ntInkMuted}{HTML}{8A8A8F}
\definecolor{ntInkRule}{HTML}{DCDCDE}
\definecolor{ntInkPanel}{HTML}{F4F4F5}
\definecolor{ntInkAccent}{HTML}{3A3A3E}

\newcommand{\ntPaletteText}{ntInkText}
\newcommand{\ntPaletteMuted}{ntInkMuted}
\newcommand{\ntPaletteAccent}{ntInkAccent}
\newcommand{\ntPaletteRule}{ntInkRule}
\newcommand{\ntPalettePanel}{ntInkPanel}

% --- Typography --------------------------------------------------------------
% This theme is figure-first, so the graphic slot is taller than the family
% default and the caption slot correspondingly tighter.
\providecommand{\ntFigGraphicFrac}{0.55}
\providecommand{\ntFigCaptionFrac}{0.13}
\newcommand{\ntFontTitleCn}{HarmonyOS Sans SC}
\newcommand{\ntFontBodyCn}{HarmonyOS Sans SC}
\newcommand{\ntFontTitleEn}{Source Sans Pro}
\newcommand{\ntFontBodyEn}{Source Sans Pro}
\providecommand{\ntFontTitleCnFace}{HarmonyOS Sans SC Regular}
\providecommand{\ntFontTitleCnBoldFace}{HarmonyOS Sans SC Bold}
\providecommand{\ntFontBodyCnFace}{HarmonyOS Sans SC Regular}
\providecommand{\ntFontBodyCnBoldFace}{HarmonyOS Sans SC Bold}

\RequirePackage{../common/beamer-nature-common}
\RequirePackage{tikz}

% --- Chrome: hairline only, no colour furniture ------------------------------
\newcommand{\ntFooter}{%
  \begin{tikzpicture}[remember picture,overlay]
    \draw[\ntPaletteRule,line width=0.3pt]
      ([yshift=4.6mm]current page.south west) --
      ([yshift=4.6mm]current page.south east);
    \node[anchor=south west,inner sep=0pt]
      at ([xshift=10mm,yshift=2.2mm]current page.south west)
      {\fontsize{6.8}{7.8}\selectfont\color{\ntPaletteMuted}\insertshorttitle};
    \node[anchor=south east,inner sep=0pt]
      at ([xshift=-10mm,yshift=2.2mm]current page.south east)
      {\fontsize{6.8}{7.8}\selectfont\color{\ntPaletteMuted}\insertframenumber};
  \end{tikzpicture}%
}

% Oversized, tight-leading title: the defining gesture of this theme.
\setbeamertemplate{frametitle}{%
  \vspace{2.6mm}%
  {\fontsize{19}{22}\selectfont\color{ntInkBlack}\bfseries
   \setlength{\baselineskip}{22pt}\insertframetitle\par}%
  \vspace{2mm}%
}
\setbeamertemplate{footline}{}
\addtobeamertemplate{frametitle}{\ntFooter}{}

% --- Body slides -------------------------------------------------------------
% Square markers, no colour; numbers carry the emphasis instead.
\setbeamertemplate{itemize item}{\color{ntInkAccent}\rule[0.40ex]{1.4mm}{1.4mm}}
\setbeamertemplate{itemize subitem}{\color{\ntPaletteMuted}\textendash}
\setbeamertemplate{enumerate item}{%
  {\fontsize{9.2}{9.8}\selectfont\color{ntInkBlack}\bfseries\insertenumlabel}%
}
\setbeamerfont{itemize/enumerate body}{size=\fontsize{10}{13}}
\setbeamerfont{itemize/enumerate subbody}{size=\fontsize{9}{11.4}}

\setbeamertemplate{block begin}{%
  \vskip3mm%
  {\fontsize{9.6}{11.4}\selectfont\color{ntInkBlack}\bfseries\insertblocktitle\par}%
  \vspace{1mm}%
  {\color{\ntPaletteRule}\rule{\linewidth}{0.4pt}\par}%
  \vspace{1.4mm}%
}
\setbeamertemplate{block end}{\vskip1mm}

% --- Title page --------------------------------------------------------------
\newcommand{\naturetitlepage}{%
  \begin{frame}[plain]
    \vspace{14mm}
    {\fontsize{7.6}{9.4}\selectfont\color{\ntPaletteMuted}\MakeUppercase{文献汇报}\par}
    \vspace{3.6mm}
    {\fontsize{24}{28}\selectfont\color{ntInkBlack}\bfseries
     \setlength{\baselineskip}{28pt}\inserttitle\par}
    \vspace{6mm}
    {\fontsize{9.8}{12}\selectfont\color{\ntPaletteMuted}\insertauthor\par}
    \vspace{1.4mm}
    {\fontsize{8.2}{10}\selectfont\color{\ntPaletteMuted}\insertinstitute\par}
    \vfill
    {\fontsize{7.8}{9.4}\selectfont\color{\ntPaletteMuted}%
     \ifx\ntVenue\undefined\else\ntVenue\quad·\quad\fi\insertdate\par}
    \vspace{5mm}
  \end{frame}%
}

% --- Section divider ---------------------------------------------------------
% The section phrase is set very large and low, echoing a magazine spread.
\newcommand{\naturesection}[1]{%
  \begin{frame}[plain]
    \vfill
    {\fontsize{7.6}{9.4}\selectfont\color{\ntPaletteMuted}\MakeUppercase{Part}\par}
    \vspace{3mm}
    {\fontsize{21}{24}\selectfont\color{ntInkBlack}\bfseries
     \setlength{\baselineskip}{24pt}#1\par}
    \vspace{5mm}
  \end{frame}%
}

% --- Two-column comparison ---------------------------------------------------
% Distinguish the columns with weight, not colour.
\newcommand{\naturetwocol}[5]{%
  \begin{frame}[t]{#1}
    \begin{columns}[T,onlytextwidth]
      \begin{column}{0.48\textwidth}
        {\fontsize{10}{11.8}\selectfont\color{ntInkBlack}\bfseries #2\par}
        \vspace{1.3mm}
        {\color{ntInkBlack}\rule{9mm}{1.1pt}\par}
        \vspace{1.8mm}
        {\fontsize{9.4}{12}\selectfont #3\par}
      \end{column}
      \hfill
      \begin{column}{0.48\textwidth}
        {\fontsize{10}{11.8}\selectfont\color{\ntPaletteMuted}\bfseries #4\par}
        \vspace{1.3mm}
        {\color{\ntPaletteRule}\rule{9mm}{1.1pt}\par}
        \vspace{1.8mm}
        {\fontsize{9.4}{12}\selectfont #5\par}
      \end{column}
    \end{columns}
  \end{frame}%
}

% --- Closing -----------------------------------------------------------------
\newcommand{\natureclosing}[1]{%
  \begin{frame}[plain]
    \vfill
    \raggedright
    {\fontsize{19}{22.5}\selectfont\color{ntInkBlack}\bfseries #1\par}
    \vspace{3.6mm}
    {\color{\ntPaletteRule}\rule{22mm}{0.8pt}\par}
    \vfill
  \end{frame}%
}
