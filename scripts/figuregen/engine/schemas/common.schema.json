{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/paperfig/paperfig/schemas/common.schema.json",
  "title": "Paperfig Common Definitions",
  "type": "object",
  "$defs": {
    "locale": {
      "type": "string",
      "enum": ["en", "zh-CN"]
    },
    "visualPreset": {
      "type": "string",
      "enum": ["paper", "paper-dark", "blueprint-print", "brutalism", "playful", "neumorphism", "memphis", "glass", "bauhaus", "apple"]
    },
    "qualityProfile": {
      "type": "string",
      "enum": ["standard", "showcase"]
    },
    "point": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "size": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": 24 },
        { "type": "number", "minimum": 18 }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "legendMode": {
      "type": "string",
      "enum": ["auto", "all", "hidden"]
    },
    "legendEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "visible": { "type": "boolean" }
      }
    },
    "guidedViews": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "focus"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "label": { "type": "string", "minLength": 1 },
          "focus": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "note": { "type": "string" }
        }
      }
    }
  }
}
