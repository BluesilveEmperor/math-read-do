{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Reproduction Manifest / 复现清单",
  "description": "冻结的完整复现环境快照，用于精确复现 / Frozen complete reproduction environment snapshot for exact reproduction",
  "type": "object",
  "required": ["schema_version", "host", "language_runtimes", "timestamp"],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Schema version / 模式版本"
    },
    "host": {
      "type": "object",
      "description": "宿主系统信息 / Host system information",
      "properties": {
        "os": { "type": "string" },
        "arch": { "type": "string" },
        "gpu": {
          "type": "object",
          "properties": {
            "present": { "type": "boolean" },
            "name": { "type": "string" },
            "driver": { "type": "string" },
            "cuda": { "type": "string" }
          }
        }
      }
    },
    "language_runtimes": {
      "type": "object",
      "description": "语言运行时版本 (已安装) / Language runtime versions (installed)",
      "properties": {
        "python": {
          "type": "object",
          "properties": {
            "version": { "type": "string" },
            "manager": { "type": "string", "enum": ["pyenv", "conda", "system"] },
            "path": { "type": "string" }
          }
        },
        "julia": {
          "type": "object",
          "properties": {
            "version": { "type": "string" },
            "manager": { "type": "string", "enum": ["juliaup", "system"] },
            "path": { "type": "string" }
          }
        }
      }
    },
    "compilers": {
      "type": "object",
      "description": "编译器版本 / Compiler versions",
      "properties": {
        "gcc": { "type": "string" },
        "gfortran": { "type": "string" },
        "cuda": { "type": "string" }
      }
    },
    "package_manifests": {
      "type": "object",
      "description": "包管理器锁定文件路径 / Package manager lock file paths",
      "properties": {
        "conda": { "type": "string" },
        "pip": { "type": "string" },
        "julia": { "type": "string" },
        "r": { "type": "string" }
      }
    },
    "system_packages": {
      "type": "object",
      "description": "系统级包 / System-level packages",
      "properties": {
        "apt": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "reproduction_hash": {
      "type": "string",
      "description": "复现环境的SHA-256指纹 / SHA-256 fingerprint of reproduction environment"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "冻结时间戳 / Freeze timestamp"
    }
  }
}
