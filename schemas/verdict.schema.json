{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Reproduction Verdict / 复现判决",
  "description": "统计验证的五态判决结果 / Five-state verdict from statistical verification",
  "type": "object",
  "required": ["overall_verdict", "metrics", "timestamp"],
  "properties": {
    "overall_verdict": {
      "type": "string",
      "description": "Overall verdict / 整体判决",
      "enum": ["within_ci", "close_outside_ci", "outside_tolerance", "not_testable", "static_check_failed"]
    },
    "overall_verdict_en": {
      "type": "string",
      "description": "Overall verdict in English / 判决结果英文描述"
    },
    "overall_verdict_zh": {
      "type": "string",
      "description": "Overall verdict in Chinese / 判决结果中文描述"
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "paper_value", "reproduced_mean", "ci_lower", "ci_upper", "verdict"],
        "properties": {
          "name": { "type": "string", "description": "Metric name / 指标名称" },
          "paper_value": { "type": "number", "description": "Value claimed in paper / 论文声称值" },
          "reproduced_mean": { "type": "number", "description": "Mean of reproduced runs / 复现均值" },
          "reproduced_std": { "type": "number", "description": "Standard deviation / 标准差" },
          "ci_lower": { "type": "number", "description": "95% CI lower bound / 置信区间下界" },
          "ci_upper": { "type": "number", "description": "95% CI upper bound / 置信区间上界" },
          "ci_level": { "type": "number", "description": "Confidence level / 置信水平", "default": 0.95 },
          "num_seeds": { "type": "integer", "description": "Number of seeds used / 使用的种子数" },
          "delta_pct": { "type": "number", "description": "Relative difference in % / 相对差异百分比" },
          "tolerance_abs": { "type": "number", "description": "Absolute tolerance / 绝对容忍度" },
          "tolerance_rel": { "type": "number", "description": "Relative tolerance / 相对容忍度" },
          "verdict": {
            "type": "string",
            "enum": ["within_ci", "close_outside_ci", "outside_tolerance", "not_testable", "static_check_failed"]
          },
          "verdict_en": { "type": "string", "description": "Verdict in English / 判决英文" },
          "verdict_zh": { "type": "string", "description": "Verdict in Chinese / 判决中文" }
        }
      }
    },
    "environment": {
      "type": "object",
      "description": "Environment snapshot / 环境快照引用",
      "properties": {
        "host_detection": { "type": "string" },
        "reproduction_manifest": { "type": "string" }
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
