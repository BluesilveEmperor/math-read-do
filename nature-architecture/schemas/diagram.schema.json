{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nature-architecture/nature-architecture/schemas/diagram.schema.json",
  "title": "Paperfig Research Diagram (shared IR)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "diagram_type", "meta", "modules"],
  "properties": {
    "schema_version": { "const": 1 },
    "diagram_type": { "enum": ["model", "framework", "route", "system", "structure", "experiment"] },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "locale": { "$ref": "common.schema.json#/$defs/locale" },
        "motion": { "enum": ["on", "off", "hover", "flow", "tour"] },
        "language": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["zh-CN", "off"] },
            "allow": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "description": "Extra professional terms / reserved words allowed to stay non-Chinese."
            }
          }
        },
        "subtitle": { "type": "string" },
        "output": { "type": "string" },
        "column": { "enum": ["single", "double"] },
        "visual_preset": { "$ref": "common.schema.json#/$defs/visualPreset" },
        "quality_profile": { "$ref": "common.schema.json#/$defs/qualityProfile" },
        "views": { "$ref": "common.schema.json#/$defs/guidedViews" },
        "legend": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "$ref": "common.schema.json#/$defs/legendMode" },
            "entries": {
              "type": "object",
              "description": "Keys are module-type words; any type from the diagram's type vocabulary is accepted.",
              "additionalProperties": { "type": "object", "additionalProperties": true }
            }
          }
        },
        "viewBox": {
          "type": "array",
          "prefixItems": [
            { "type": "number", "minimum": 240 },
            { "type": "number", "minimum": 200 }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "label", "pos", "size"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "minLength": 1 },
          "type": {
            "enum": [
              "input", "embedding", "encoder", "decoder", "attention", "ffn", "norm", "activation", "pooling", "output", "residual", "concat", "custom",
              "linear", "matmul", "scale", "softmax_op", "add", "layernorm", "gelu", "scaled_dot_product_attention",
              "problem", "content", "goal", "outcome", "chapter",
              "dataset", "preprocess", "train", "eval", "metric", "baseline", "ablation",
              "client", "service", "storage"
            ]
          },
          "label": { "type": "string", "minLength": 1 },
          "sublabel": { "type": "string" },
          "shape": { "enum": ["rect", "rounded", "trapezoid", "parallelogram", "circle", "diamond"] },
          "variant": { "enum": ["default", "emphasis", "dashed", "repeated"] },
          "pos": { "$ref": "common.schema.json#/$defs/point" },
          "size": { "$ref": "common.schema.json#/$defs/size" },
          "repeat": { "type": "integer", "minimum": 2, "maximum": 96 },
          "repeat_label": { "type": "string" },
          "tensor_shape": { "type": "string" },
          "tensor_pos": { "$ref": "common.schema.json#/$defs/point" },
          "nested": {
            "type": "array",
            "items": { "type": "string" },
            "description": "IDs of modules nested inside this block (for stacked transformer blocks etc.)"
          },
          "tag": { "type": "string" }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "label", "wraps"],
        "properties": {
          "kind": { "enum": ["stage", "block", "ablation", "branch", "layer"] },
          "label": { "type": "string", "minLength": 1 },
          "wraps": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "pad": { "type": "number", "minimum": 4, "maximum": 40 },
          "variant": { "enum": ["default", "emphasis", "dashed"] }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "id": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "label": { "type": "string" },
          "variant": { "enum": ["forward", "loss", "data", "backward-skip", "label-only"] },
          "route": { "enum": ["straight", "orthogonal-h", "orthogonal-v", "curved"] },
          "fromSide": { "enum": ["top", "right", "bottom", "left"] },
          "toSide": { "enum": ["top", "right", "bottom", "left"] },
          "via": {
            "type": "array",
            "minItems": 2,
            "items": { "$ref": "common.schema.json#/$defs/point" }
          },
          "labelAt": { "$ref": "common.schema.json#/$defs/point" },
          "tensor_anno": { "type": "string" },
          "tensor_anno_at": { "$ref": "common.schema.json#/$defs/point" }
        }
      }
    },
    "cards": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "items": {
            "type": "array",
            "items": { "type": "string" }
          },
          "dot": { "enum": ["ink", "blue", "red", "gray"] }
        }
      }
    }
  }
}
