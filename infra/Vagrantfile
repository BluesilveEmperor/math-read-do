# -*- mode: ruby -*-
# vi: set ft=ruby :
# Vagrantfile - Ubuntu VM for Math Paper Reproduction
# Ubuntu VM用于数学文献实验复现

Vagrant.configure("2") do |config|
  # Base box / 基础镜像
  config.vm.box = "ubuntu/noble64"
  config.vm.box_version = "20240423.0.0"

  # Hostname
  config.vm.hostname = "math-repro"

  # Network / 网络配置
  config.vm.network "private_network", type: "dhcp"

  # Synced folder / 共享文件夹
  # 建议: 将代码放在 host 端 WSL2/NTFS 均可访问的路径
  # Recommended: place code in a path accessible from both host and VM
  config.vm.synced_folder "../reproduction", "/home/vagrant/reproduction",
    type: "virtualbox",
    mount_options: ["uid=1000", "gid=1000"]

  # Provider-specific / 提供者配置
  config.vm.provider "virtualbox" do |vb|
    vb.name = "math-repro-vm"
    vb.memory = "16384"    # 16GB RAM, adjust as needed / 按需调整
    vb.cpus = 8            # 8 cores, adjust as needed / 按需调整
    vb.gui = false

    # Enable AVX/AVX2 for scientific computing / 为科学计算启用AVX
    vb.customize ["setextradata", :id, "VBoxInternal/CPUM/IsaSet", "AVX2"]

    # GPU passthrough (requires Extension Pack) / GPU穿透(需Extension Pack)
    # 启用条件: 宿主机有NVIDIA独显且已关闭Hyper-V
    # Prerequisite: host has NVIDIA GPU and Hyper-V is disabled
    config_dedicated_gpu = "{{DEDICATED_GPU}}"  # set to "true" when GPU passthrough needed
    if config_dedicated_gpu == "true"
      vb.customize ["modifyvm", :id, "--vram", "128"]
      vb.customize ["modifyvm", :id, "--accelerate3d", "on"]
      # Attach physical GPU via VBoxManage (host-specific PCI address required)
      # 通过VBoxManage附加物理GPU (需宿主机PCI地址)
      # vb.customize ["modifyvm", :id, "--pciattach", "<host_pci_address>"]
    end
  end

  # Provisioning with Ansible / Ansible配置
  config.vm.provision "ansible" do |ansible|
    ansible.playbook = "../provisioning/playbook.yml"
    ansible.compatible_mode = "2.0"
    ansible.extra_vars = {
      paper_domain: "{{PAPER_DOMAIN}}",     # numerical/symbolic/ai4math/stats/opt
      python_version: "{{PYTHON_VERSION}}",  # e.g. 3.10.14
      julia_version: "{{JULIA_VERSION}}",     # e.g. 1.9.4
      cuda_required: "{{CUDA_REQUIRED}}",    # true/false
      gcc_version: "{{GCC_VERSION}}",        # e.g. 11
    }
  end

  # Resource limits / 资源限制
  config.vm.provider "virtualbox" do |vb|
    vb.customize ["modifyvm", :id, "--audio", "none"]
    vb.customize ["modifyvm", :id, "--usb", "off"]
  end
end
